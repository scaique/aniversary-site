{
    // Configurações gerais do editor
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,

    // Configurações específicas para TypeScript/JavaScript
    "[typescript]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[typescriptreact]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[javascript]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[javascriptreact]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },

    // Configurações do Prettier
    "prettier.tabWidth": 4,
    "prettier.useTabs": false,
    "prettier.bracketSameLine": true,
    "prettier.printWidth": 200,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.organizeImports": "explicit",
        "source.sortMembers": "explicit"
    },
    "IDX.aI.enableInlineCompletion": true,
    "IDX.aI.enableCodebaseIndexing": true,

    // Configurações Java (SIMPLIFICADAS)
    "java.import.exclusions": ["**/node_modules/**"],

    // Formatação Java e Kotlin
    "[java]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true
    },
    "[kotlin]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true
    },

    // Exclusões de arquivos
    // "files.exclude": {
    //     "**/node_modules": true
    // },
    "search.exclude": {
        "**/node_modules": true
    },
    "java.configuration.updateBuildConfiguration": "disabled"
}
